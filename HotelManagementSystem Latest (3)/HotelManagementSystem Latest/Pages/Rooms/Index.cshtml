@page
@model HotelManagementSystem.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Rooms";
}

<div class="container">
    <h2>Rooms</h2>

    @if (User.IsInRole("Admin"))
    {
        <div class="mb-3">
            <a asp-page="Create" class="btn btn-danger fw-bold">+ Add New Room</a>
        </div>
    }

    <form method="get" class="mb-3">
        <div class="row g-2">
            <div class="col-auto">
                <input type="text" name="SearchType" class="form-control" placeholder="Search room type..." value="@Model.SearchType" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter by Room Type</button>
                <a asp-page="./Index" class="btn btn-secondary">Clear Filter</a>
            </div>
        </div>
    </form>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Room Number</th>
                <th>Room Type</th>
                <th>Price Per Night</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rooms.Any())
            {
                foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td>@room.RoomNumber</td>
                        <td>@($"{room.roomType}")</td>
                        <td>@room.PricePerNight</td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@room.Id">Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <span> | </span>
                                <a asp-page="Create">+Add new room</a>
                                <span> | </span>
                                <a asp-page="./Edit" asp-route-id="@room.Id" class="text-warning">Edit</a>
                                <span> | </span>
                                <a asp-page="./Delete" asp-route-id="@room.Id" class="text-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-muted">No rooms found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>