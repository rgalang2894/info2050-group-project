@page
@model HotelManagementSystem.Pages.Rooms.DeleteModel

    <h2>Delete Room</h2>

    <div>
        <h4>Are you sure you want to delete this room?</h4>
        <dl class="row">
            <dt class="col-sm-2">
                Room Number
            </dt>
            <dd class="col-sm-10">
                @Model.Room.RoomNumber
            </dd>
            <dt class="col-sm-2">
                roomType
            </dt>
            <dd class="col-sm-10">
                @Model.Room.roomType
            </dd>
            <dt class="col-sm-2">
                Price per Night
            </dt>
            <dd class="col-sm-10">
                @Model.Room.PricePerNight.ToString("C")
            </dd>
        </dl>
        <form method="post">
            <input type="hidden" asp-for="Room.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>

