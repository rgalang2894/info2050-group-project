@page
@model HotelManagementSystem.Pages.Bookings.DetailsModel

@{
    ViewData["Title"] = "Booking Details";
}


<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white p-3">
            <h3 class="mb-0">Booking for @Model.Booking.CustomerName</h3>
        </div>
        <div class="card-body p-4">
            <div class="row mb-3 border-bottom pb-2">
                <div class="col-sm-4 fw-bold text-muted">Guest Name</div>
                <div class="col-sm-8">@Model.Booking.CustomerName</div>
            </div>
            <div class="row mb-3 border-bottom pb-2">
                <div class="col-sm-4 fw-bold text-muted">Room Number</div>
                <div class="col-sm-8">
                    @if (Model.Booking.Room != null)
                    {
                        <span class="badge bg-info text-dark">Room Number: @Model.Booking.Room.RoomNumber</span>
                    }
                    else
                    {
                        <span class="text-danger">Room assignment missing</span>
                    }
                </div>
            </div>
            <div class="row mb-3 border-bottom pb-2">
                <div class="col-sm-4 fw-bold text-muted">Check-In Date</div>
                <div class="col-sm-8">@Model.Booking.CheckInDate.ToString("MMMM dd, yyyy")</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-muted">Check-Out Date</div>
                <div class="col-sm-8">@Model.Booking.CheckOutDate.ToString("MMMM dd, yyyy")</div>
            </div>

            <div class="row mb-3 border-bottom pb-2">
                <div class="col-sm-4 fw-bold text-muted">Price Per Night</div>
                <div class="col-sm-8">
                    @{
                        var pricePerNight = Model.Booking.Room?.PricePerNight ?? 0;
                        var nights = Math.Max(1, (Model.Booking.CheckOutDate - Model.Booking.CheckInDate).Days);
                        var total = nights * pricePerNight;
                    }
                    @pricePerNight.ToString("C")
                </div>
            </div>

            <div class="row mb-3 border-bottom pb-2">
                <div class="col-sm-4 fw-bold text-muted">Number of Nights</div>
                <div class="col-sm-8">@nights</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-muted">Total Cost</div>
                <div class="col-sm-8 fw-bold text-success">@total.ToString("C")</div>
            </div>
            
            <div class="mt-4">
                <a asp-page="./Edit" asp-route-id="@Model.Booking.Id" class="btn btn-warning">Edit Booking</a>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Back to List</a>
            </div>
        </div>
        
        <div class="card-footer bg-light text-end">
            <small class="text-muted">Booking Reference ID: @Model.Booking.Id</small>
        </div>
    </div>
</div>