@model HotelManagementSystem.Models.Booking;

<div class="mb-3">
    <label asp-for="CustomerName" class="form-label"></label>
    <input asp-for="CustomerName" class="form-control" />
    <span asp-validation-for="CustomerName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="RoomId" class="form-label">Select Room</label>
    <select asp-for="RoomId" class="form-select" asp-items="@(ViewData["RoomOptions"] as SelectList)">
        <option value="">-- Select a Room --</option>
    </select>
    <span asp-validation-for="RoomId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col">
        <label asp-for="CheckInDate" class="form-label">Check-In Date</label>
        <input asp-for="CheckInDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="CheckInDate" class="text-danger"></span>
    </div>

    <div class="col">
        <label asp-for="CheckOutDate" class="form-label">Check-Out Date</label>
        <input asp-for="CheckOutDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="CheckOutDate" class="text-danger"></span>
    </div>
</div>


