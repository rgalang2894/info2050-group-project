@page
@model HotelManagementSystem.Pages.Bookings.DeleteModel

<div class="container mt-5">
    <div class="card border-danger shadow-sm border-0">
        <div class="card-header bg-danger text-white p-3">
            <h3 class="mb-0">Delete Booking Confirmation</h3>
        </div>
        <div class="card-body p-4">
            <h4 class="text-danger mb-4">Are you sure you want to delete this booking?</h4>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-bold text-muted">Guest Name</dt>
                <dd class="col-sm-8">@Model.Booking.CustomerName</dd>

                <dt class="col-sm-4 fw-bold text-muted">Room Number</dt>
                <dd class="col-sm-8">
                    @if (Model.Booking.Room != null)
                    {
                        <span class="badge bg-info text-dark">Room @Model.Booking.Room.RoomNumber</span>
                    }
                </dd>

                <dt class="col-sm-4 fw-bold text-muted">Check-In</dt>
                <dd class="col-sm-8">@Model.Booking.CheckInDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-4 fw-bold text-muted">Check-Out</dt>
                <dd class="col-sm-8">@Model.Booking.CheckOutDate.ToString("MMMM dd, yyyy")</dd>
            </dl>

            <form method="post" class="mt-4">
                <input type="hidden" asp-for="Booking.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
