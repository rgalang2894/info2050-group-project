# Ignore common IDE/editor and OS files
.vs/
.vscode/
.idea/
*.sln.iml

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
bin/
obj/

# Test and coverage output
[Tt]est[Rr]esults/
coverage/
coverage.*
*.coverage
*.coveragexml

# NuGet packages and generated package files
*.nupkg
*.snupkg
packages/
!packages/build/

# Logs and temporary files
*.log
*.tmp
*.temp

# SQLite DB files used for local development
*.db
*.db-shm
*.db-wal

# IIS Express/apphost
/.vs/**/applicationhost.config

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
